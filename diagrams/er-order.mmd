erDiagram
  USER ||--o{ ORDER : places
  ORDER ||--|{ ORDER_ITEM : contains
  ORDER ||--|| ADDRESS : ships_to
  ORDER ||--o| PAYMENT : settled_by
  ORDER {
    int id PK
    int user_id FK
    int address_id FK
    string status
    int total_krw
    datetime placed_at
  }
  ORDER_ITEM {
    int id PK
    int order_id FK
    int product_id FK
    int quantity
    int unit_price_krw
  }
  ADDRESS {
    int id PK
    string recipient
    string phone
    string zip
    string line1
    string line2
  }
  PAYMENT {
    int id PK
    int order_id FK
    string method
    string status
    int amount_krw
  }

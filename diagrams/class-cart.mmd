classDiagram
  class Cart {
    +Uuid id
    +User owner
    +DateTimeImmutable createdAt
    +addItem(Product, int) void
    +removeItem(Product) void
    +totalKrw() int
    +itemCount() int
  }
  class CartItem {
    +int id
    +Product product
    +int quantity
    +int subtotalKrw()
  }
  class CartFactory {
    +forUser(User) Cart
    +forGuest(Session) Cart
    +mergeGuestIntoUser(Cart, Cart) Cart
  }
  Cart "1" *-- "*" CartItem
  CartItem "*" --> "1" Product
  CartFactory ..> Cart : builds

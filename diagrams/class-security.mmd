classDiagram
  class User {
    +int id
    +string email
    +string passwordHash
    +array roles
    +getUserIdentifier() string
  }
  class PasswordHasherInterface {
    +hash(string) string
    +verify(string, string) bool
  }
  class Authenticator {
    +authenticate(Request) Passport
  }
  class Voter {
    +supports(string, mixed) bool
    +voteOnAttribute(string, mixed) bool
  }
  class Firewall
  Firewall --> Authenticator : runs
  Authenticator --> User : loads
  Authenticator --> PasswordHasherInterface : verifies
  Voter ..> User : reads

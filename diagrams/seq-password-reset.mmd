sequenceDiagram
  participant U as User
  participant W as Web
  participant DB as Database
  participant M as Mailer
  U->>W: POST /password/forgot (email)
  W->>DB: find user by email
  DB-->>W: user or null
  alt user found
    W->>DB: store reset token (1h ttl)
    W->>M: send reset email
    M-->>U: email with link
  else not found
    W-->>U: 200 (silent)
  end
  U->>W: GET /password/reset/{token}
  W->>DB: validate token
  W-->>U: form
  U->>W: POST new password
  W->>DB: update hash, expire token
  W-->>U: 302 /login
